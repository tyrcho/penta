#!/usr/bin/env bash
# Repo-level pre-commit hook, picked up automatically by Datadog's global
# git hooks (run-local-hooks looks for <repo-root>/hooks/pre-commit).
#
# Checks (never auto-fixes) staged Scala files' formatting via
# scripts/check-scalafmt-diff.py (game/.scalafmt.conf), scoped to game/ since
# that's the only Scala project in this repo — run `scalafmt <file>` yourself
# and re-stage before committing. Deliberately diff-aware, not a blanket
# `scalafmt --check`: this codebase went uncommitted-hook for a while, so
# several files have pre-existing formatting drift nobody asked this pass to
# fix; check-scalafmt-diff.py only fails on reformatting that overlaps lines
# this commit actually staged, so a commit's diff stays exactly what the
# author intended and pre-existing drift elsewhere in a touched file doesn't
# also drag unrelated methods into the method-length check below (which uses
# the same overlap technique).
# Markdown *is* still auto-fixed (markdownlint-cli2 --fix, across the whole
# repo — the rest of this repo is an Obsidian vault, not just game/'s docs):
# markdownlint's fixes are narrowly scoped (trailing whitespace, blank-line
# rules, ...) and don't cascade into any other check here.
#
# Three more checks, only when Scala files are staged:
#   - WartRemover (build.sbt's banOptionGetWarts) via `sbt compile` — banned
#     Option/Either/Try #get sites fail the actual compile, so this reuses
#     the compiler, not a separate lint pass.
#   - scripts/check-method-length.py — scalastyle can't parse this codebase
#     at all (see that script's own doc), so this stands in for its
#     method-length rule specifically.
#   - jscpd (Copy/Paste Detector, run via `npx`, no local install needed) —
#     scoped by .jscpd.json at the repo root; catches duplicated Scala
#     production code (tests are excluded, see .jscpd.json). NOT the vault's
#     .base files: the 5 per-faction Bases views are near-identical by
#     necessity (Obsidian's Bases format has no include/anchor mechanism
#     across files), so flagging that duplication would either block every
#     commit forever or require deleting the very views that were asked for
#     — see .jscpd.json's own doc.
# All three block the commit on a finding — there's no auto-fix for any of
# them, unlike scalafmt/markdownlint above.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" # git invokes hooks from the repo root already; this just makes
                # the relative paths below correct if run manually from elsewhere.
GAME_DIR="$REPO_ROOT/game"

staged() { git diff --cached --name-only --diff-filter=ACM -- "$@"; }

scala_files=$(staged "$GAME_DIR" | grep -E '\.(scala|sc)$' || true)
md_files=$(staged | grep -E '\.mdx?$' || true)

fail=0

if [ -n "$scala_files" ]; then
  scalafmt_bin="$(command -v scalafmt || true)"
  if [ -z "$scalafmt_bin" ] && [ -x "$HOME/Library/Application Support/Coursier/bin/scalafmt" ]; then
    scalafmt_bin="$HOME/Library/Application Support/Coursier/bin/scalafmt"
  fi
  if [ -n "$scalafmt_bin" ]; then
    echo "pre-commit: checking staged Scala files' formatting (diff-aware)..."
    if ! PATH="$(dirname "$scalafmt_bin"):$PATH" python3 "$GAME_DIR/scripts/check-scalafmt-diff.py" $scala_files; then
      echo "pre-commit: formatting issues (see above) — run scalafmt on these files and re-stage." >&2
      fail=1
    fi
  else
    echo "pre-commit: scalafmt not found (cs install scalafmt) — skipping Scala formatting check" >&2
  fi

  echo "pre-commit: checking method length (scripts/check-method-length.py)..."
  if ! python3 "$GAME_DIR/scripts/check-method-length.py" $scala_files; then
    echo "pre-commit: method(s) above the length limit (see above)." >&2
    fail=1
  fi

  sbt_bin="$(command -v sbt || true)"
  if [ -n "$sbt_bin" ]; then
    echo "pre-commit: compiling with WartRemover's Option/Either/Try #get ban..."
    if ! (cd "$GAME_DIR" && "$sbt_bin" --batch "coreJVM/compile" "js/compile" "sim/compile"); then
      echo "pre-commit: compile failed — see WartRemover errors above (or a real compile error)." >&2
      fail=1
    fi
  else
    echo "pre-commit: sbt not found — skipping WartRemover" >&2
  fi
fi

echo "pre-commit: checking for duplicated code (jscpd)..."
if command -v npx >/dev/null 2>&1; then
  if ! npx --yes jscpd --config "$REPO_ROOT/.jscpd.json" "$GAME_DIR/core" "$GAME_DIR/js" "$GAME_DIR/sim"; then
    echo "pre-commit: jscpd found duplicated code (see above)." >&2
    fail=1
  fi
else
  echo "pre-commit: npx not found — skipping jscpd" >&2
fi

if [ -n "$md_files" ]; then
  if command -v markdownlint-cli2 >/dev/null 2>&1; then
    config_flag=""
    if [ -f "$REPO_ROOT/.markdownlint.json" ]; then
      config_flag="--config $REPO_ROOT/.markdownlint.json"
    elif [ -f "$GAME_DIR/.markdownlint.json" ]; then
      config_flag="--config $GAME_DIR/.markdownlint.json"
    fi
    echo "pre-commit: formatting staged Markdown files..."
    markdownlint-cli2 --fix $config_flag $md_files || true
    echo "$md_files" | xargs git add
    echo "pre-commit: linting staged Markdown files..."
    if ! markdownlint-cli2 $config_flag $md_files; then
      echo "pre-commit: markdownlint found issues --fix couldn't resolve (see above)." >&2
      fail=1
    fi
  else
    echo "pre-commit: markdownlint-cli2 not found (brew install markdownlint-cli2) — skipping Markdown lint" >&2
  fi
fi

exit $fail
